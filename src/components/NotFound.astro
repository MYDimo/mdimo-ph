---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import { useT, localizedPath, routes } from '../i18n/index.js';

const { locale } = Astro.props;
const tr = useT(locale);
---

<BaseLayout locale={locale} title={tr('notFound.title')} noindex>
  <section class="shell pt-16 md:pt-24">
    <PageIntro heading={tr('notFound.title')} text={tr('notFound.text')}>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localizedPath(locale)} class="btn btn-lg btn-primary">
          {tr('notFound.home')}
        </a>
        <a href={localizedPath(locale, routes.moments)} class="btn btn-lg btn-light">
          {tr('nav.moments')}
        </a>
      </div>
    </PageIntro>
  </section>
</BaseLayout>

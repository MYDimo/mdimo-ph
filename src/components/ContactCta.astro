---
import { useT, localizedPath, routes } from '../i18n/index.js';

const { locale } = Astro.props;
const tr = useT(locale);
---

<section class="shell pt-section">
  <div class="rounded-2xl bg-base-100 px-6 py-12 text-center md:px-12 md:py-16">
    <p class="text-title font-semibold">{tr('contactCta.text')}</p>
    <a
      href={localizedPath(locale, routes.contact)}
      class="btn btn-lg btn-primary mt-6"
    >
      {tr('contactCta.link')}
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

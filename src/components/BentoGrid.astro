---
/*
 * Selected-work bento. Six tiles on a 2-col (mobile) / 4-col (desktop) grid:
 *   [ big 2x2 ][ tall ][ sq ]
 *   [        ][      ][ sq ]
 *   [   wide    ][   wide   ]
 */
import { Picture } from 'astro:assets';
import { bg } from '../data/colors.js';

const { tiles } = Astro.props; // [{ src, alt, href }]
const shapes = [
  { cls: 'col-span-2 row-span-2', sizes: '(min-width: 768px) 38rem, 92vw' },
  { cls: 'row-span-2', sizes: '(min-width: 768px) 19rem, 46vw' },
  { cls: '', sizes: '(min-width: 768px) 19rem, 46vw' },
  { cls: '', sizes: '(min-width: 768px) 19rem, 46vw' },
  { cls: 'col-span-2', sizes: '(min-width: 768px) 38rem, 92vw' },
  { cls: 'col-span-2', sizes: '(min-width: 768px) 38rem, 92vw' },
];
---

<ul class="grid auto-rows-[10.5rem] grid-cols-2 gap-3 md:auto-rows-[15rem] md:grid-cols-4 md:gap-4" data-dim-group>
  {
    tiles.slice(0, shapes.length).map((tile, i) => (
      <li class:list={[shapes[i].cls]} data-lift>
        <a href={tile.href} class="group block h-full overflow-hidden rounded-xl bg-base-300" style={bg(tile.src)} data-reveal="image">
          <Picture formats={['avif']} fallbackFormat="webp"
            src={tile.src}
            alt={tile.alt}
            widths={[320, 480, 640, 800, 1000, 1200]}
            sizes={shapes[i].sizes}
            class="fade-img size-full object-cover object-top transition-transform duration-700 ease-soft group-hover:scale-[1.012]"
          />
        </a>
      </li>
    ))
  }
</ul>

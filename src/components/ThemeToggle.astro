---
import { useT } from '../i18n/index.js';
const { locale } = Astro.props;
const tr = useT(locale);
---

<button
  type="button"
  class="theme-toggle relative grid size-11 place-items-center rounded-full text-base-content/80 transition-colors hover:bg-base-300/70 hover:text-base-content"
  aria-label={tr('theme.toggle')}
  aria-pressed="false"
  data-theme-toggle
>
  <!-- Coloured ring that blooms outward on each switch (amber for day, violet for night). -->
  <span class="bloom" aria-hidden="true"></span>
  <!-- Sun: shown in light theme -->
  <svg class="icon-sun size-[1.375rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <g class="rays">
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
    </g>
  </svg>
  <!-- Moon (with a tiny star): shown in night theme -->
  <svg class="icon-moon size-[1.375rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    <path class="star" d="M18 3.2v2.6M16.7 4.5h2.6"></path>
  </svg>
</button>

<style>
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition: opacity 0.3s var(--ease-soft), transform 0.5s var(--ease-soft);
  }
  .rays,
  .star {
    transform-box: fill-box;
    transform-origin: center;
  }
  .rays {
    transform-origin: 12px 12px;
    transform-box: view-box;
  }
  .star {
    opacity: 0;
  }

  /* Resting states */
  .icon-moon { opacity: 0; transform: rotate(-70deg) scale(0.5); }
  :global([data-theme='night']) .icon-sun { opacity: 0; transform: rotate(90deg) scale(0.4); }
  :global([data-theme='night']) .icon-moon { opacity: 1; transform: none; }
  :global([data-theme='night']) .star { opacity: 1; }

  /* Switching to day: the sun swells in amber while its rays turn a quarter. */
  .theme-toggle.to-day .icon-sun { animation: sun-pop 0.9s var(--ease-soft); }
  .theme-toggle.to-day .rays { animation: rays-turn 0.9s var(--ease-soft); }
  @keyframes sun-pop {
    0% { transform: rotate(-90deg) scale(0.4); opacity: 0; }
    55% { transform: scale(1.3); opacity: 1; color: #f5a524; }
    100% { transform: none; }
  }
  @keyframes rays-turn {
    from { transform: rotate(-45deg); }
    to { transform: rotate(45deg); }
  }

  /* Switching to night: the moon rolls in violet and a star twinkles on. */
  .theme-toggle.to-night .icon-moon { animation: moon-in 0.9s var(--ease-soft); }
  .theme-toggle.to-night .star { animation: twinkle 0.9s var(--ease-soft) 0.35s both; }
  @keyframes moon-in {
    0% { transform: rotate(-70deg) scale(0.5); opacity: 0; }
    55% { transform: rotate(8deg) scale(1.2); opacity: 1; color: #a594ff; }
    100% { transform: none; }
  }
  @keyframes twinkle {
    0% { opacity: 0; transform: scale(0) rotate(-90deg); }
    60% { opacity: 1; transform: scale(1.5) rotate(0); }
    100% { opacity: 1; transform: none; }
  }

  .bloom {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
  }
  .theme-toggle.to-day .bloom { background: #f5a524; animation: bloom 0.9s var(--ease-soft); }
  .theme-toggle.to-night .bloom { background: #8b7cf6; animation: bloom 0.9s var(--ease-soft); }
  @keyframes bloom {
    from { transform: scale(0.5); opacity: 0.5; }
    to { transform: scale(2.2); opacity: 0; }
  }

  /*
   * Theme change as a circular reveal: the new theme spreads out from the toggle
   * (same-document View Transition, animated from the script). During it, page
   * elements give up their own transition names so the whole page reveals as one.
   */
  :global(html.vt-theme body),
  :global(html.vt-theme body *) {
    view-transition-name: none !important;
  }
  :global(html.vt-theme::view-transition-old(root)),
  :global(html.vt-theme::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = document.querySelectorAll('[data-theme-toggle]');

  const sync = () => {
    const isNight = root.dataset.theme === 'night';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(isNight)));
  };

  /** Switch theme; when supported, reveal it as a circle growing from `origin`. */
  function setTheme(theme, origin) {
    const apply = () => {
      root.dataset.theme = theme;
      sync();
    };
    if (!origin || reduce.matches || !document.startViewTransition) return apply();

    const r = origin.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add('vt-theme');
    const t = document.startViewTransition(apply);
    t.ready
      .then(() =>
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 750, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
        ),
      )
      .catch(() => {}); // skipped transitions (e.g. hidden tab) still apply the theme
    t.finished.catch(() => {}).finally(() => root.classList.remove('vt-theme'));
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'night' ? 'light' : 'night';
      // Restart the icon animation (sun pop or moon roll) for this switch.
      b.classList.remove('to-day', 'to-night');
      void b.offsetWidth;
      b.classList.add(next === 'night' ? 'to-night' : 'to-day');
      setTheme(next, b);
      try { localStorage.setItem('theme', next); } catch {}
    }),
  );

  // Keep following the system while the visitor hasn't made a manual choice.
  media.addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (!saved) setTheme(e.matches ? 'night' : 'light');
  });

  sync();
</script>

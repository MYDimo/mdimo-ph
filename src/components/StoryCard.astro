---
// Rounded card: image on one side, text on the other. `reverse` puts the image first on desktop.
const { heading, text, link, reverse = false } = Astro.props;
---

<article class="grid items-center gap-8 rounded-2xl bg-base-100 p-4 md:grid-cols-2 md:gap-12 md:p-5">
  <div class:list={['aspect-[4/5] rounded-xl bg-base-300', reverse ? 'md:order-first' : 'md:order-last']}>
    <slot name="image" />
  </div>
  <div class="px-3 pb-6 md:px-8 md:py-10">
    <h2 class="text-headline">{heading}</h2>
    <p class="mt-6 text-muted">{text}</p>
    {
      link && (
        <a href={link.href} class="mt-8 inline-flex items-center gap-2 font-medium underline-offset-4 hover:underline">
          {link.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

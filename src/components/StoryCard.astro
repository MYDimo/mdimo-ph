---
// Rounded card: photo on one side, text on the other. `reverse` puts the photo first on desktop.
import { Image } from 'astro:assets';
import { bg } from '../data/colors.js';

// `position`: object-position for the photo crop (e.g. to keep a face in frame).
const { heading, text, link, image, alt, reverse = false, position = 'center' } = Astro.props;
---

<article class="grid items-center gap-8 rounded-2xl bg-base-100 p-4 md:grid-cols-2 md:gap-12 md:p-5">
  <div
    class:list={['aspect-[4/5] overflow-hidden rounded-xl bg-base-300', reverse ? 'md:order-first' : 'md:order-last']}
    data-reveal="image"
    style={bg(image)}
  >
    <Image
      src={image}
      alt={alt}
      widths={[320, 480, 640, 800, 1000, 1200]}
      sizes="(min-width: 768px) min(45vw, 36rem), 92vw"
      class="fade-img size-full scale-[1.12] object-cover"
      style={`object-position: ${position}`}
      data-parallax
    />
  </div>
  <div class="px-3 pb-6 md:px-8 md:py-10">
    <h2 class="text-headline">{heading}</h2>
    <p class="mt-6 text-muted">{text}</p>
    {
      link && (
        <a href={link.href} class="cta-link mt-8 inline-flex items-center gap-2 font-medium">
          <span class="cta-text">{link.label}</span> <span class="arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

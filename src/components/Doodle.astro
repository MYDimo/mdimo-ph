---
/*
 * Hand-drawn style line icons in the same pen as the logo (round caps, one
 * weight). Each path has pathLength="1", so the icon draws itself stroke by
 * stroke when it scrolls into view (data-reveal="doodle", see motion.css).
 * Purely decorative: always aria-hidden.
 */
const { name, class: className = 'size-7' } = Astro.props;

const icons = {
  // Services
  rings: ['M4.5 14.5a5 5 0 1 0 10 0a5 5 0 1 0 -10 0', 'M9.5 12.5a5 5 0 1 0 10 0a5 5 0 1 0 -10 0', 'M14.5 4.5l1.5 -2l1.5 2l-1.5 2z'],
  candle: ['M9.5 21v-9.5h5v9.5', 'M7 21h10', 'M12 9c-1.7 -1.3 -1.7 -3.3 0 -5.5c1.7 2.2 1.7 4.2 0 5.5z'],
  heart: ['M12 20s-7.5 -4.6 -7.5 -9.8a3.8 3.8 0 0 1 7.5 -1.4a3.8 3.8 0 0 1 7.5 1.4c0 5.2 -7.5 9.8 -7.5 9.8z'],
  note: ['M9 18a2.2 2.2 0 1 1 -4.4 0a2.2 2.2 0 1 1 4.4 0', 'M9 18v-12l10 -2.5v12', 'M19 15.5a2.2 2.2 0 1 1 -4.4 0a2.2 2.2 0 1 1 4.4 0'],
  // How it works
  envelope: ['M3.5 7h17v11h-17z', 'M3.5 7l8.5 6.5l8.5 -6.5'],
  bubbles: ['M3.5 5h11v7.5h-6l-3 3v-3h-2z', 'M14.5 9.5h6v7h-2v2.5l-2.8 -2.5h-4.7v-2.5'],
  calendar: ['M4.5 6h15v13.5h-15z', 'M4.5 10h15', 'M8.5 3.5v4.5M15.5 3.5v4.5', 'M9 15l2 2l4 -4'],
  camera: ['M3.5 8.5h4l1.5 -2.5h6l1.5 2.5h4v10.5h-17z', 'M8.6 13.5a3.4 3.4 0 1 0 6.8 0a3.4 3.4 0 1 0 -6.8 0'],
  sparkle: ['M11 4c.8 4.2 2.8 6.2 7 7c-4.2 .8 -6.2 2.8 -7 7c-.8 -4.2 -2.8 -6.2 -7 -7c4.2 -.8 6.2 -2.8 7 -7z', 'M19 2.5v3.5M17.25 4.25h3.5'],
  photos: ['M7 8.5h13v11h-13z', 'M4.5 16v-9.5h12', 'M7 17l3.8 -3.8l3 3l2 -2l4.2 4.2'],
  // Lists
  tick: ['M5 12.5l4.5 4.5l9.5 -9.5'],
};
const paths = icons[name] ?? [];
---

<svg
  class:list={['doodle', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-reveal="doodle"
>
  {paths.map((d, i) => <path d={d} pathLength="1" style={`--p: ${i}`} />)}
</svg>

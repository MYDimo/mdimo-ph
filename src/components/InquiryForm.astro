---
/*
 * Inquiry form (Netlify Forms). The static markup below is what Netlify detects
 * at deploy time: the form name, `data-netlify`, and every field name must stay
 * identical in both languages. The script submits in the background and shows
 * the result in place; without JS the browser posts normally to Netlify.
 */
import { useT } from '../i18n/index.js';
import { inquiryServices } from '../data/services.js';
import { contact } from '../data/contact.js';

const { locale } = Astro.props;
const tr = useT(locale);
const field = 'input w-full';
---

<form
  name="inquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="rounded-2xl bg-base-100 p-5 md:p-8"
  data-inquiry-form
  data-sending={tr('inquiry.sending')}
>
  <input type="hidden" name="form-name" value="inquiry" />
  <input type="hidden" name="language" value={locale} />
  <p class="hidden">
    <label>{tr('inquiry.honeypot')} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-4 sm:grid-cols-2" data-form-fields>
    <label class="form-field">
      <span>{tr('inquiry.fields.name')}</span>
      <input class={field} type="text" name="name" autocomplete="name" required />
    </label>
    <label class="form-field">
      <span>{tr('inquiry.fields.email')}</span>
      <!-- type=email alone accepts "name@host" (no dot); the pattern also requires a domain
           with a dot and a 2+ letter ending, e.g. name@example.com (Cyrillic endings work too). -->
      <input
        class={field}
        type="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        spellcheck="false"
        pattern="[^\s@]+@[^\s@]+\.[^\s@.]{2,}"
        data-email-message={tr('inquiry.emailInvalid')}
        required
      />
    </label>
    <label class="form-field">
      <span>{tr('inquiry.fields.phone')} <small>({tr('inquiry.optional')})</small></span>
      <input class={field} type="tel" name="phone" autocomplete="tel" />
    </label>
    <label class="form-field">
      <span>{tr('inquiry.fields.date')}</span>
      <input class={field} type="date" name="date" />
    </label>
    <label class="form-field">
      <span>{tr('inquiry.fields.service')}</span>
      <select class="select w-full" name="service" data-service-select>
        {inquiryServices.map((s) => <option value={s}>{tr(`inquiry.serviceOptions.${s}`)}</option>)}
      </select>
    </label>
    <label class="form-field">
      <span>{tr('inquiry.fields.location')}</span>
      <input class={field} type="text" name="location" />
    </label>
    <label class="form-field sm:col-span-2">
      <span>{tr('inquiry.fields.message')}</span>
      <textarea class="textarea min-h-32 w-full" name="message" rows="5" required></textarea>
    </label>

    <p class="text-sm text-muted sm:col-span-2">{tr('inquiry.note')}</p>
    <button
      type="submit"
      class="send-btn relative overflow-hidden rounded-full bg-primary px-6 py-3.5 font-medium text-primary-content transition-opacity hover:opacity-85 sm:col-span-2"
      data-state="idle"
    >
      <span class="send-label" data-send-label>{tr('inquiry.submit')}</span>
      <!-- Spinner while sending, then a check that draws itself on success. -->
      <svg class="send-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle></svg>
      <svg class="send-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
    </button>
  </div>

  <!-- Result panels, shown by the script. -->
  <div class="form-success py-6 text-center" role="status" aria-live="polite" tabindex="-1" data-form-success hidden>
    <p class="text-title font-semibold">{tr('inquiry.successTitle')}</p>
    <p class="mt-2 text-muted">{tr('inquiry.success')}</p>
    <button type="button" class="mt-6 text-sm font-medium underline underline-offset-4" data-form-again>
      {tr('inquiry.sendAnother')}
    </button>
  </div>
  <p class="mt-4 text-sm" role="alert" data-form-error hidden>
    {tr('inquiry.error')}
    {tr('inquiry.errorDirect')} <a class="underline underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a>.
  </p>
</form>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-field > span {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .form-field small {
    font-weight: 400;
    color: var(--muted);
  }
  /* Send button states: idle → sending (spinner) → done (check) */
  .send-btn svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .send-label { display: inline-block; transition: opacity 0.25s, transform 0.4s var(--ease-soft); }
  .send-btn:not([data-state='idle']) .send-label { opacity: 0; transform: translateY(-8px); }
  .send-btn[data-state='sending'] .send-spinner { opacity: 1; }
  .send-spinner circle { stroke-dasharray: 40 60; animation: spin 0.9s linear infinite; transform-origin: center; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .send-btn[data-state='done'] .send-check { opacity: 1; }
  .send-check path { stroke-dasharray: 24; stroke-dashoffset: 24; }
  .send-btn[data-state='done'] .send-check path { animation: draw 0.5s var(--ease-soft) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  /* The thank-you panel rises in. */
  .form-success:not([hidden]) { animation: rise-in 0.7s var(--ease-soft); }
  @keyframes rise-in { from { opacity: 0; transform: translateY(16px); } }

  /* Calm, borderless fields on a subtle fill; the ring appears only on focus. */
  .form-field :is(.input, .select, .textarea) {
    background: var(--color-base-200);
    border-color: transparent;
    box-shadow: none;
    font-size: 1rem; /* 16px+ prevents iOS zoom on focus */
  }
  .form-field :is(.input, .select, .textarea):focus,
  .form-field :is(.input, .select, .textarea):focus-within {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: transparent;
  }
</style>

<script>
  document.querySelectorAll('[data-inquiry-form]').forEach((form) => {
    const fields = form.querySelector('[data-form-fields]');
    const success = form.querySelector('[data-form-success]');
    const error = form.querySelector('[data-form-error]');
    const button = fields.querySelector('button[type="submit"]');
    const sendLabel = button.querySelector('[data-send-label]');
    const label = sendLabel.textContent;

    // Preselect the service from a link like ?service=wedding#inquiry.
    const wanted = new URLSearchParams(location.search).get('service');
    const select = form.querySelector('[data-service-select]');
    if (wanted && [...select.options].some((o) => o.value === wanted)) select.value = wanted;

    // Friendly, translated message for a malformed email (the browser default is generic).
    const email = form.querySelector('input[name="email"]');
    const checkEmail = () => {
      email.setCustomValidity('');
      email.setCustomValidity(email.validity.typeMismatch || email.validity.patternMismatch ? email.dataset.emailMessage : '');
    };
    email.addEventListener('input', checkEmail);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      email.value = email.value.trim();
      checkEmail();
      if (!form.reportValidity()) return;
      error.hidden = true;
      button.disabled = true;
      button.dataset.state = 'sending';
      sendLabel.textContent = form.dataset.sending; // announced to screen readers via the button name
      const wait = (ms) => new Promise((r) => setTimeout(r, ms));
      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        // Netlify Forms only exist on the deployed site; in local dev we simulate success.
        // The POST goes to this page's own URL (where Netlify found the form). Posting to "/"
        // would be caught by the root redirect and silently never reach the form.
        const res = import.meta.env.DEV
          ? await wait(700).then(() => ({ ok: true }))
          : await fetch(location.pathname, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        button.dataset.state = 'done';
        await wait(650); // let the check draw before the panel swaps in
        form.reset();
        fields.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        error.hidden = false;
      } finally {
        button.disabled = false;
        button.dataset.state = 'idle';
        sendLabel.textContent = label;
      }
    });

    form.querySelector('[data-form-again]').addEventListener('click', () => {
      success.hidden = true;
      fields.hidden = false;
      fields.querySelector('input:not([type="hidden"])').focus();
    });
  });
</script>

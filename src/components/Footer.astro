---
import { useT } from '../i18n/index.js';

const { locale } = Astro.props;
const tr = useT(locale);
const year = new Date().getFullYear();
---

<footer class="shell pb-8 pt-section">
  <p class="border-t border-base-300 pt-6 text-sm text-muted">© {year} {tr('site.name')}. {tr('footer.rights')}</p>
</footer>

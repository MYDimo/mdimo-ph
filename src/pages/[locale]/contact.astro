---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { useT } from '../../i18n/index.js';
import { contact } from '../../data/contact.js';
export { localeStaticPaths as getStaticPaths } from '../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
const direct = [
  { label: tr('contact.email'), value: contact.email, href: `mailto:${contact.email}`, copy: true },
  { label: tr('contact.phone'), value: contact.phoneDisplay, href: `tel:${contact.phone}` },
  { label: tr('contact.instagram'), value: contact.instagram, href: contact.instagramUrl, external: true },
];
---

<BaseLayout locale={locale} title={tr('contact.title')} description={tr('seo.contact')}>
  <section id="inquiry" class="shell grid gap-10 pt-16 md:grid-cols-[2fr_3fr] md:gap-12 md:pt-24">
    <div>
      <PageIntro heading={tr('contact.heading')} text={tr('contact.text')} />
      <div class="mt-12">
        <h2 class="eyebrow">{tr('contact.direct')}</h2>
        <dl class="mt-5 space-y-4">
          {
            direct.map((d) => (
              <div>
                <dt class="text-sm text-muted">{d.label}</dt>
                <dd class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <a
                    href={d.href}
                    class="cta-link text-lg font-medium"
                    {...(d.external ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    <span class="cta-text">{d.value}</span>
                  </a>
                  {d.copy && (
                    <button
                      type="button"
                      class="copy-btn rounded-full bg-base-100 px-3 py-1 text-sm text-muted hover:text-base-content"
                      data-copy={d.value}
                      data-copied={tr('ui.copied')}
                      hidden
                    >
                      <span data-copy-label>{tr('ui.copy')}</span>
                    </button>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-8 text-sm text-muted">{tr('contact.based')}</p>
      </div>
    </div>
    <InquiryForm locale={locale} />
  </section>
</BaseLayout>

<style>
  .copy-btn[data-done] { color: var(--color-base-content); }
  .copy-btn[data-done] [data-copy-label] { animation: copied 0.5s var(--ease-spring); }
  @keyframes copied { from { opacity: 0; transform: translateY(6px); } }
</style>

<script>
  // Copy the email with one click; the label briefly says "Copied". Hidden without clipboard support.
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const label = btn.querySelector('[data-copy-label]');
    const original = label.textContent;
    let timer;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        label.textContent = btn.dataset.copied;
        btn.setAttribute('data-done', '');
        clearTimeout(timer);
        timer = setTimeout(() => {
          label.textContent = original;
          btn.removeAttribute('data-done');
        }, 1800);
      } catch {}
    });
  });
</script>

---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StoryCard from '../../components/StoryCard.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import MomentCard from '../../components/MomentCard.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import { useT, localizedPath, routes } from '../../i18n/index.js';
import { heroSlides, storyImages, bentoTiles } from '../../data/home.js';
import { getMoments } from '../../data/moments.js';
import { contact } from '../../data/contact.js';
import { bg } from '../../data/colors.js';
export { localeStaticPaths as getStaticPaths } from '../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
const momentsHref = localizedPath(locale, routes.moments);
// The bento photos come from Elena Madlena & Asen's wedding, so the tiles open that Moment.
const bentoHref = `${momentsHref}elena-madlena-and-asen/`;
const tiles = bentoTiles.map((t) => ({ src: t.src, alt: tr(`home.alt.${t.alt}`), href: bentoHref }));

// Services block: each card shows the cover of a Moment of that kind and opens the Services page.
const moments = await getMoments(locale);
const coverOf = (slug) => moments.find((m) => m.slug === slug)?.cover;
const servicesPath = localizedPath(locale, routes.services);
const serviceCards = [
  { id: 'weddings', moment: 'silvana-and-ivan', href: `${servicesPath}#weddings` },
  { id: 'christening', moment: 'viki-christening', href: `${servicesPath}#more` },
  { id: 'couple', moment: 'radina-and-martin', href: `${servicesPath}#more` },
  { id: 'events', moment: 'probiv', href: `${servicesPath}#more` },
].map((c) => ({ ...c, cover: coverOf(c.moment) }));

// One full-width photo between sections: the sparklers from Valentina & Danail's wedding.
const feature = moments.find((m) => m.slug === 'valentina-and-danail');
const featurePhoto = feature?.images[20];
// The latest few Moments, newest first.
const recent = moments.slice(0, 4);

// Preload the first hero frame (the LCP image) with the same srcset the carousel uses.
const lcp = await getImage({ src: heroSlides[0].src, widths: [320, 480, 640, 800, 1000, 1200] });

// Structured data so search engines understand who and where this is.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: tr('site.name'),
  description: tr('site.description'),
  url: new URL(localizedPath(locale), Astro.site).href,
  image: new URL(lcp.src, Astro.site).href,
  email: contact.email,
  telephone: contact.phone,
  address: { '@type': 'PostalAddress', addressLocality: locale === 'bg' ? 'София' : 'Sofia', addressCountry: 'BG' },
  areaServed: [{ '@type': 'Country', name: locale === 'bg' ? 'България' : 'Bulgaria' }],
  priceRange: '€€',
  sameAs: [contact.instagramUrl],
};
---

<BaseLayout locale={locale} title={tr('home.title')} jsonLd={jsonLd}>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={lcp.srcSet.attribute}
    imagesizes="(min-width: 768px) 25vw, 82vw"
    fetchpriority="high"
  />

  <section class="pt-14 md:pt-20" data-hero>
    <div class="shell text-center" data-hero-heading>
      <h1 class="mx-auto max-w-4xl text-display">{tr('home.hero')}</h1>
      <a
        href="#intro"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-[0.9375rem] font-medium text-primary-content transition-opacity hover:opacity-85"
      >
        {tr('home.explore')} <span class="arrow arrow-down" aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="shell mt-12 md:mt-16 md:w-[80vw] md:max-w-none md:px-0" data-hero-frames>
      <HeroCarousel locale={locale} slides={heroSlides} />
    </div>
  </section>

  <section id="intro" class="shell py-section text-center">
    <p class="mx-auto max-w-5xl text-headline font-semibold" data-statement>
      {
        tr('home.statement').map((line) => (
          <span class="block">
            {/* Each word sits in its own clipping mask so it can rise into view (see home-scroll.js). */}
            <span class="stmt-word"><em class="font-serif font-normal text-muted" data-word data-lead>{line.lead}</em></span>{' '}
            {line.text.split(' ').map((word) => (
              <>
                <span class="stmt-word"><span data-word>{word}</span></span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </section>

  <section class="shell">
    <StoryCard
      heading={tr('home.story.heading')}
      text={tr('home.story.text')}
      image={storyImages.story.src}
      alt={tr(`home.alt.${storyImages.story.alt}`)}
    />
  </section>

  <section class="shell pt-section">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <PageIntro as="h2" eyebrow={tr('home.selected.eyebrow')} heading={tr('home.selected.heading')} />
      <a href={momentsHref} class="inline-flex items-center gap-2 font-medium underline-offset-4 hover:underline">
        {tr('home.selected.link')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <BentoGrid tiles={tiles} />
  </section>

  {
    feature && featurePhoto && (
      <section class="pt-section">
        {/* Near edge-to-edge photo: breaks the card rhythm with one big moment (gentle parallax). */}
        <a
          href={`${momentsHref}${feature.slug}/`}
          class="group relative mx-2 block h-[70vh] min-h-[26rem] overflow-hidden rounded-2xl md:mx-3"
          style={bg(featurePhoto)}
          data-reveal="image"
        >
          <Image
            src={featurePhoto}
            alt={tr('moments.photoAlt', { title: feature.entry.data.title, n: 21, total: feature.images.length })}
            widths={[640, 1000, 1400, 1800, 2048]}
            sizes="100vw"
            class="fade-img size-full scale-[1.12] object-cover"
            data-parallax
          />
          <span class="absolute bottom-4 left-4 rounded-full bg-base-100/85 px-4 py-2 font-serif text-[0.9375rem] italic backdrop-blur md:bottom-6 md:left-6">
            {feature.entry.data.title}
            {feature.entry.data.location && ` · ${feature.entry.data.location}`}
            <span class="arrow ml-1 not-italic" aria-hidden="true">→</span>
          </span>
        </a>
      </section>
    )
  }

  <section class="shell pt-section">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <PageIntro as="h2" eyebrow={tr('home.services.eyebrow')} heading={tr('home.services.heading')} />
      <a href={servicesPath} class="inline-flex items-center gap-2 font-medium underline-offset-4 hover:underline">
        {tr('home.services.link')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" data-dim-group>
      {
        serviceCards.map((c) => (
          <li data-lift>
            <a href={c.href} class="group block h-full rounded-2xl bg-base-100 p-2.5 md:p-3">
              <div class="aspect-[4/5] overflow-hidden rounded-xl bg-base-300" style={bg(c.cover)} data-reveal="image">
                {c.cover && (
                  <Image
                    src={c.cover}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 768px) 17rem, 44vw"
                    class="fade-img size-full object-cover object-top transition-transform duration-700 ease-soft group-hover:scale-[1.012]"
                  />
                )}
              </div>
              <div class="px-1.5 pb-2 pt-4">
                <h3 class="font-semibold leading-snug">{tr(`home.services.items.${c.id}.name`)}</h3>
                <p class="mt-1 text-sm text-muted">{tr(`home.services.items.${c.id}.text`)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pt-section">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <PageIntro as="h2" eyebrow={tr('home.recent.eyebrow')} heading={tr('home.recent.heading')} />
      <a href={momentsHref} class="inline-flex items-center gap-2 font-medium underline-offset-4 hover:underline">
        {tr('home.recent.link')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    {/* Swipeable row of the latest Moments (native scroll-snap). */}
    <div class="recent-row flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2" data-dim-group>
      {
        recent.map((m) => (
          <div class="w-[72%] shrink-0 snap-start sm:w-[40%] lg:w-[calc((100%-3rem)/4)]">
            <MomentCard locale={locale} moment={m} sizes="(min-width: 1024px) 18rem, 72vw" />
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell pt-section">
    <StoryCard
      reverse
      heading={tr('home.meet.heading')}
      text={tr('home.meet.text')}
      link={{ href: localizedPath(locale, routes.about), label: tr('home.meet.link') }}
      image={storyImages.meet.src}
      alt={tr(`home.alt.${storyImages.meet.alt}`)}
    />
  </section>
</BaseLayout>

<style>
  /* Word mask for the statement reveal; the padding keeps descenders and italics unclipped. */
  .stmt-word {
    display: inline-block;
    overflow: clip;
    padding: 0 0.08em 0.14em;
    margin: 0 -0.08em -0.14em;
    vertical-align: bottom;
  }
  .stmt-word > * { display: inline-block; }
  .recent-row { scrollbar-width: none; }
  .recent-row::-webkit-scrollbar { display: none; }
  /* Words arrive in the accent colour and settle into their own colour, in reading order. */
  :global(html.motion) [data-statement] :global([data-word]) {
    transition: color 1.6s var(--ease-soft) calc(var(--i, 0) * 55ms);
  }
  :global(html.motion) [data-statement]:not(:global(.is-lit)) :global([data-word]) {
    color: var(--color-accent);
  }
</style>

<script>
  // Scroll animations are an enhancement: load GSAP only after the page is idle,
  // and not at all when the visitor prefers reduced motion.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const load = () => import('../../scripts/home-scroll.js').then((m) => m.initHomeScroll());
    'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 300);
  }
</script>

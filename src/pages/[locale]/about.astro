---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { useT } from '../../i18n/index.js';
import { heroSlides } from '../../data/home.js';
import { bg } from '../../data/colors.js';
import portrait from '../../assets/about/self-portrait.jpg';
export { localeStaticPaths as getStaticPaths } from '../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
// Three favourites from the home carousel.
const favourites = [heroSlides[2], heroSlides[3], heroSlides[5]];
---

<BaseLayout locale={locale} title={tr('about.title')} description={tr('seo.about')} image={portrait}>
  <section class="shell grid items-center gap-10 pt-16 md:grid-cols-[3fr_2fr] md:gap-14 md:pt-24">
    <div>
      <h1 class="text-display">{tr('about.heading')}</h1>
      <p class="mt-8 text-title font-normal leading-snug text-base-content/85">{tr('about.text')}</p>
      <p class="mt-6 max-w-2xl text-muted">{tr('about.more')}</p>
    </div>
    <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-base-300" style={bg(portrait)} data-reveal="image">
      <Picture formats={['avif']} fallbackFormat="webp"
        src={portrait}
        alt={tr('about.portraitAlt')}
        widths={[480, 640, 800, 1000, 1200]}
        sizes="(min-width: 768px) 30rem, 92vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[60%_35%]"
      />
    </div>
  </section>

  <section class="shell pt-section">
    <h2 class="eyebrow">{tr('about.favourites')}</h2>
    <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {
        favourites.map((photo, i) => (
          <div class:list={['aspect-[4/5] overflow-hidden rounded-xl bg-base-300', i === 2 && 'hidden md:block']} style={bg(photo.src)} data-reveal="image">
            <Picture formats={['avif']} fallbackFormat="webp"
              src={photo.src}
              alt={tr(`home.alt.${photo.alt}`)}
              widths={[320, 480, 640, 800]}
              sizes="(min-width: 768px) 24rem, 46vw"
              class="fade-img size-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </section>

  <ContactCta locale={locale} />
</BaseLayout>

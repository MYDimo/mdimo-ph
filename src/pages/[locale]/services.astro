---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { useT, formatPrice, formatRange, localizedPath, routes } from '../../i18n/index.js';
import { weddingPackages, moreServices } from '../../data/services.js';
import { getMoments } from '../../data/moments.js';
import { fillFacts } from '../../data/facts.js';
import { bg } from '../../data/colors.js';
export { localeStaticPaths as getStaticPaths } from '../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
const price = (n) => formatPrice(locale, n);
const moments = await getMoments(locale);
const momentOf = (slug) => moments.find((m) => m.slug === slug);
const momentsPath = localizedPath(locale, routes.moments);

const moreMeta = (s) =>
  s.pricePerHour
    ? `${price(s.pricePerHour)} ${tr('units.perHour')} · ${tr('units.minHours', { n: s.minHours })}`
    : `${price(s.price)} · ${tr('units.hours', { n: formatRange(locale, ...s.hours) })}`;

// Links that jump to the form below with the service preselected.
const bookHref = (service) => `?service=${service}#inquiry`;

// A photo on top of each wedding collection (the recommended one gets the wider card).
const packagePhotos = {
  essential: momentOf('elena-madlena-and-asen')?.images[9],
  signature: momentOf('elani-and-stanislav')?.images[18],
};
// Hand-placed, slightly "random" positions for the milestones: --x is how far
// across the free width the card sits (0 = left, 1 = right); --gap is the space above it.
const roadPlaces = [
  '--x: 0.06; --gap: 0rem',
  '--x: 0.78; --gap: 1.5rem',
  '--x: 0.3; --gap: 3rem',
  '--x: 0.96; --gap: 0.5rem',
  '--x: 0.12; --gap: 2.5rem',
  '--x: 0.58; --gap: 1rem',
];

// FAQ answers carry the live numbers (prices, travel rate, overtime).
const fill = (text) => fillFacts(locale, text);

// Structured data: each service with its public price, plus the FAQ as FAQPage.
const abs = (p) => new URL(p, Astro.site).href;
// Points at the full business record on the home page (same @id), instead of repeating a partial copy here.
const provider = { '@id': `${abs(localizedPath(locale))}#business` };
const offer = (amount, extra = {}) => ({ '@type': 'Offer', priceCurrency: 'EUR', price: amount, availability: 'https://schema.org/InStock', ...extra });
const service = (name, description, offers) => ({
  '@type': 'Service',
  serviceType: name,
  name,
  description,
  provider,
  areaServed: { '@type': 'Country', name: locale === 'bg' ? 'България' : 'Bulgaria' },
  offers,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...weddingPackages.map((p) => {
      const info = tr(`services.weddings.packages.${p.id}`);
      return service(info.name, info.summary, offer(p.price));
    }),
    ...moreServices.map((s) => {
      const info = tr(`services.more.items.${s.id}`);
      const offers = s.pricePerHour
        ? offer(s.pricePerHour, { priceSpecification: { '@type': 'UnitPriceSpecification', price: s.pricePerHour, priceCurrency: 'EUR', unitCode: 'HUR' } })
        : offer(s.price);
      return service(info.name, info.text, offers);
    }),
    {
      '@type': 'FAQPage',
      mainEntity: tr('services.faq.items').map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: fill(item.a) },
      })),
    },
  ],
};
const approach = tr('services.intro.approach');
---

<BaseLayout locale={locale} title={tr('services.title')} description={tr('seo.services')} image={momentOf('silvana-and-ivan')?.cover} jsonLd={jsonLd}>
  <!-- 01 Intro: what I do + how I work (approach first, prices right after) -->
  <section class="shell pt-16 md:pt-24">
    <PageIntro
      eyebrow={tr('services.intro.eyebrow')}
      heading={tr('services.intro.heading')}
      text={tr('services.intro.text')}
    />
    <!-- The approach, as a big editorial statement: a quiet lead-in, then the promise. -->
    <blockquote class="approach relative mt-16 md:mt-24 md:pl-24">
      <span class="approach-mark" aria-hidden="true">“</span>
      <p class="font-serif" data-split>
        <span class="text-muted">{approach.lead}</span>
        {' '}{approach.main}{' '}
        <span class="approach-hl">
          {approach.mark}
        </span>
      </p>
    </blockquote>
  </section>

  <!-- 02 Wedding collections -->
  <section id="weddings" class="shell scroll-mt-24 pt-section">
    <PageIntro
      as="h2"
      eyebrow={tr('services.weddings.eyebrow')}
      heading={tr('services.weddings.heading')}
      text={tr('services.weddings.text')}
    />
    <div class="mt-10 grid items-start gap-4 md:grid-cols-[5fr_7fr]" data-reveal-group>
      {
        weddingPackages.map((p) => (
          <article
            data-reveal="rise"
            class:list={['flex flex-col rounded-2xl bg-base-100 p-3', p.recommended && 'ring-2 ring-accent']}
          >
            {packagePhotos[p.id] && (
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-base-300" style={bg(packagePhotos[p.id])} data-reveal="image">
                <Picture formats={['avif']} fallbackFormat="webp"
                  src={packagePhotos[p.id]}
                  alt=""
                  widths={[400, 640, 900, 1200]}
                  sizes="(min-width: 768px) 44rem, 92vw"
                  class="fade-img size-full object-cover object-[50%_30%]"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-4 pt-6 md:p-6">
              <div class="flex min-h-7 items-center justify-between gap-4">
                <h3 class="eyebrow">{tr(`services.weddings.packages.${p.id}.name`)}</h3>
                {p.recommended && (
                  <span class="rounded-full bg-primary px-3 py-1 text-label font-medium text-primary-content">
                    {tr('services.weddings.recommended')}
                  </span>
                )}
              </div>
              <p class="mt-5 text-headline font-semibold">{price(p.price)}</p>
              <p class="mt-1 font-serif text-muted">{tr('units.upToHours', { n: p.upToHours })}</p>
              <p class="mt-6">{tr(`services.weddings.packages.${p.id}.summary`)}</p>
              <p class="eyebrow mt-8">{tr('services.weddings.includes')}</p>
              <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
                {tr(`services.weddings.packages.${p.id}.items`).map((item, i) => (
                  <li class="flex gap-3" style={`--d: ${i}`}>
                    {item}
                  </li>
                ))}
              </ul>
              <p class="mt-8 text-sm text-muted">
                {tr('services.weddings.overtime')}: {price(p.overtimePerHour)} {tr('units.perHour')}
              </p>
              <div class="mt-auto pt-8">
                <a
                  href={bookHref('wedding')}
                  class:list={['btn', p.recommended ? 'btn-primary' : 'btn-soft']}
                >
                  {tr('services.weddings.book')}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 03 More ways to remember -->
  <section class="shell pt-section">
    <PageIntro as="h2" eyebrow={tr('services.more.eyebrow')} heading={tr('services.more.heading')} />
    <div class="mt-10 grid gap-4 md:grid-cols-3" data-reveal-group data-dim-group>
      {
        moreServices.map((s) => {
          const m = momentOf(s.moment);
          return (
            <article id={s.id} class="flex scroll-mt-24 flex-col rounded-2xl bg-base-100 p-3" data-lift>
              {m && (
                <a href={`${momentsPath}${m.slug}/`} class="block aspect-square overflow-hidden rounded-xl bg-base-300" style={bg(m.cover)} data-reveal="image">
                  <Picture formats={['avif']} fallbackFormat="webp"
                    src={m.cover}
                    alt={m.entry.data.title}
                    widths={[320, 480, 640, 800]}
                    sizes="(min-width: 768px) 24rem, 92vw"
                    class="fade-img size-full object-cover object-top"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-4 pt-5">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-title font-semibold">{tr(`services.more.items.${s.id}.name`)}</h3>
                </div>
                <p class="mt-2 font-serif text-muted">{moreMeta(s)}</p>
                <p class="mt-5 text-[0.9375rem]">{tr(`services.more.items.${s.id}.text`)}</p>
                <div class="mt-auto flex flex-wrap items-center justify-center gap-2 pt-6">
                  <a href={bookHref(s.id)} class="btn btn-soft">
                    {tr('services.more.book')}
                  </a>
                  {m && (
                    <a href={`${momentsPath}${m.slug}/`} class="cta-link btn btn-outline">
                      <span class="cta-text">{tr('services.more.seeMoment')}</span> <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- 04 How it works + 05 FAQ, side by side, in a section a bit wider than the page.
       The heading and a rounded "screen" frame form a stage. As the section arrives
       the frame grows into place, then the stage pins, centred on screen (with the
       FAQ beside it), while scrolling moves the winding road and its milestones
       inside the frame. When the last milestone is reached the pin releases.
       Logic: src/scripts/services-road.js. Without JS / with reduced motion it's a
       normal, un-pinned section with the whole road drawn. -->
  <section class="road-section pt-section">
    <div class="road-layout grid gap-10 md:grid-cols-[3fr_2fr] md:gap-8 lg:gap-12">
      <div class="road-pin" data-road-pin>
        <div class="road-stage" data-road-stage>
          <PageIntro as="h2" eyebrow={tr('services.process.eyebrow')} heading={tr('services.process.heading')} />
          <div class="road-frame mt-8 rounded-2xl bg-base-100" data-road-frame>
          <div class="road-bar">
            <span>{tr('services.process.frameLabel')}</span>
            <span class="road-count" aria-hidden="true"><span data-road-count>1</span> / {tr('services.process.steps').length}</span>
          </div>
          <div class="road-viewport" data-road-viewport>
            <div class="road relative" data-road>
              <svg class="road-svg" aria-hidden="true">
                <path class="road-base" />
                <path class="road-progress" />
                <circle class="road-tip" r="5" />
              </svg>
              <ol class="relative">
                {
                  tr('services.process.steps').map((step, i) => (
                    <li class="road-step" style={roadPlaces[i]} data-road-step>
                      <div class="road-card rounded-2xl bg-base-200 p-5" data-road-node>
                        <div class="flex items-center gap-3">
                          <span class="road-num">{String(i + 1).padStart(2, '0')}</span>
                          <h3 class="text-lg font-semibold leading-tight">{step.title}</h3>
                        </div>
                        <p class="mt-2 text-[0.9375rem] text-muted">{step.text}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
        </div>
      </div>

      <!-- FAQ: stays beside the frame while it's pinned (desktop). -->
      <div class="road-faq">
        <div class="road-faq-stage">
          <p class="eyebrow mb-4">{tr('services.faq.eyebrow')}</p>
          <h2 class="text-title font-semibold">{tr('services.faq.heading')}</h2>
          <div class="mt-6 divide-y divide-base-300 rounded-2xl bg-base-100 px-5 md:px-6">
            {
              tr('services.faq.items').map((item) => (
                <details class="faq group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-medium">
                    {item.q}
                    <span class="faq-icon" aria-hidden="true"></span>
                  </summary>
                  <p class="pb-5 pr-6 text-[0.9375rem] text-muted">{fill(item.a)}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Start a conversation -->
  <section id="inquiry" class="shell grid scroll-mt-24 gap-10 pt-section md:grid-cols-[2fr_3fr] md:gap-12">
    <PageIntro as="h2" eyebrow={tr('inquiry.eyebrow')} heading={tr('inquiry.heading')} text={tr('inquiry.text')} />
    <InquiryForm locale={locale} />
  </section>
</BaseLayout>

<style>
  /* ── How it works: wide section, pinned stage, frame ──────────────── */
  .road-section {
    width: 100%;
    max-width: 88rem; /* a bit wider than the rest of the page (76rem) */
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }
  .road-pin {
    --header-h: 4.5rem;
    --frame-h: min(calc(100svh - var(--header-h) - 14rem), 54rem);
  }
  @media (max-width: 47.99rem) {
    .road-pin { --header-h: 4rem; --frame-h: calc(100svh - var(--header-h) - 11rem); }
  }
  .road-frame {
    display: flex;
    flex-direction: column;
    box-shadow: 0 0 0 1px var(--color-base-300);
    transform-origin: 50% 0;
  }
  /* "Screen" title bar: label on the left, milestone counter on the right. */
  .road-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--color-base-300);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }
  .road-count { font-family: var(--font-serif); font-variant-numeric: tabular-nums; }
  .road-viewport { position: relative; padding: 1.5rem 1.25rem 2rem; }

  /* Pinned mode (whenever motion is allowed, from the first paint so nothing
     jumps): the wrapper is tall; the stage (heading + frame) sticks and is
     centred in the space below the header; the road scrolls inside the frame. */
  :global(html.motion) .road-pin { height: calc(100svh - var(--header-h) + 220svh); }
  :global(html.motion) .road-stage {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  :global(html.motion) .road-frame { height: var(--frame-h); }
  :global(html.motion) .road-viewport { flex: 1; overflow: hidden; }
  :global(html.motion) .road { will-change: transform; }
  /* Soft fade at the frame's top and bottom edges while the road scrolls. */
  :global(html.motion) .road-viewport::before,
  :global(html.motion) .road-viewport::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 3rem;
    z-index: 2;
    pointer-events: none;
  }
  :global(html.motion) .road-viewport::before { top: 0; background: linear-gradient(var(--color-base-100), transparent); }
  :global(html.motion) .road-viewport::after { bottom: 0; background: linear-gradient(transparent, var(--color-base-100)); }

  /* The FAQ is centred and sticks beside the pinned stage on desktop. */
  @media (min-width: 48rem) {
    .road-faq-stage {
      position: sticky;
      top: 4.5rem;
      min-height: calc(100svh - 4.5rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  .road-svg {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke-linecap: round;
  }
  .road-base {
    stroke: var(--color-base-300);
    stroke-width: 2;
    stroke-dasharray: 2 9;
  }
  .road-progress {
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }
  .road-tip {
    fill: var(--color-accent);
    stroke: none;
  }
  /* Compact cards scattered across the frame; the road runs between them
     (it passes under the cards, which sit above the drawing). */
  .road-step {
    --w: min(84%, 19rem);
    position: relative;
    width: var(--w);
    margin-top: calc(1.75rem + var(--gap, 0rem) * 0.6);
    margin-left: calc((100% - var(--w)) * var(--x, 0) * 0.7);
  }
  .road-step:first-child { margin-top: 0.5rem; }
  @media (min-width: 48rem) {
    .road-step {
      --w: min(62%, 20rem);
      margin-top: calc(1.5rem + var(--gap, 0rem));
      margin-left: calc((100% - var(--w)) * var(--x, 0));
    }
  }
  .road-num {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--muted);
    transition: color 0.5s;
  }
  .road-card {
    position: relative;
    transform-origin: center;
  }

  /* Milestones grow and fade with their distance from the pen tip (the point the
     road is being drawn to): they arrive small and faint, are full size when the
     line reaches them, and shrink and fade again as it moves on (--s / --o are set by the script on each scroll; only the
     contents fade so the cards stay opaque over the road). The one the line has
     reached last also gets an accent ring and number. */
  .road-card > * { opacity: var(--o, 1); }
  :global(html.motion) .road-card { transform: scale(var(--s, 1)); transition: box-shadow 0.6s var(--ease-soft); }
  :global(html.motion) .road-step:global(.is-current) .road-card { box-shadow: 0 0 0 1.5px var(--color-accent); }
  :global(html.motion) .road-step:global(.is-current) .road-num { color: var(--color-accent); }

  /* ── Approach statement ─────────────────────────────────────────────── */
  .approach p {
    font-size: clamp(2rem, 1.1rem + 3.6vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .approach-mark {
    position: absolute;
    left: -0.25rem;
    top: -3.25rem;
    font-family: var(--font-serif);
    font-size: clamp(6rem, 4rem + 6vw, 10rem);
    line-height: 1;
    color: var(--color-accent);
  }
  @media (min-width: 48rem) { .approach-mark { top: -1.5rem; left: 0; } }
  .approach-hl { position: relative; white-space: nowrap; }

  /* FAQ: smooth open/close where supported (interpolate-size), a plus that turns into a cross. */
  .faq {
    interpolate-size: allow-keywords;
  }
  .faq::details-content {
    height: 0;
    overflow: clip;
    transition: height 0.5s var(--ease-soft), content-visibility 0.5s allow-discrete;
  }
  .faq[open]::details-content {
    height: auto;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon {
    position: relative;
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    transition: transform 0.45s var(--ease-spring);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    translate: 0 -50%;
  }
  .faq-icon::after { rotate: 90deg; }
  .faq[open] .faq-icon { transform: rotate(45deg); color: var(--color-accent); }

</style>

<script>
  import { initRoad } from '../../scripts/services-road.js';
  document.querySelectorAll('[data-road-pin]').forEach(initRoad);
</script>

---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import Doodle from '../../components/Doodle.astro';
import { useT, formatPrice, formatRange, localizedPath, routes } from '../../i18n/index.js';
import { weddingPackages, moreServices, travelRatePerKm } from '../../data/services.js';
import { getMoments } from '../../data/moments.js';
import { bg } from '../../data/colors.js';
export { localeStaticPaths as getStaticPaths } from '../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
const price = (n) => formatPrice(locale, n);
const moments = await getMoments(locale);
const momentOf = (slug) => moments.find((m) => m.slug === slug);
const momentsPath = localizedPath(locale, routes.moments);

const moreMeta = (s) =>
  s.pricePerHour
    ? `${price(s.pricePerHour)} ${tr('units.perHour')} · ${tr('units.minHours', { n: s.minHours })}`
    : `${price(s.price)} · ${tr('units.hours', { n: formatRange(locale, ...s.hours) })}`;

// Links that jump to the form below with the service preselected.
const bookHref = (service) => `?service=${service}#inquiry`;

// A photo on top of each wedding collection (the recommended one gets the wider card).
const packagePhotos = {
  essential: momentOf('elena-madlena-and-asen')?.images[9],
  signature: momentOf('elani-and-stanislav')?.images[18],
};
const moreDoodles = { christening: 'candle', couple: 'heart', events: 'note' };
const stepDoodles = ['envelope', 'bubbles', 'calendar', 'camera', 'sparkle', 'photos'];
// Hand-placed, slightly "random" positions for the milestones: --x is how far
// across the free width the card sits (0 = left, 1 = right); --gap is the space above it.
const roadPlaces = [
  '--x: 0.06; --gap: 0rem',
  '--x: 0.78; --gap: 1.5rem',
  '--x: 0.3; --gap: 3rem',
  '--x: 0.96; --gap: 0.5rem',
  '--x: 0.12; --gap: 2.5rem',
  '--x: 0.58; --gap: 1rem',
];

// FAQ answers carry the live numbers (travel rate, overtime prices).
const faqVars = {
  rate: formatPrice(locale, travelRatePerKm, { decimals: 2 }),
  essential: price(weddingPackages[0].overtimePerHour),
  signature: price(weddingPackages[1].overtimePerHour),
};
const fill = (text) => text.replace(/\{(\w+)\}/g, (_, k) => faqVars[k] ?? `{${k}}`);
---

<BaseLayout locale={locale} title={tr('services.title')} description={tr('seo.services')} image={momentOf('silvana-and-ivan')?.cover}>
  <!-- 01 Intro: what I do + how I work (approach first, prices right after) -->
  <section class="shell grid items-end gap-10 pt-16 md:grid-cols-[3fr_2fr] md:gap-14 md:pt-24">
    <PageIntro
      eyebrow={tr('services.intro.eyebrow')}
      heading={tr('services.intro.heading')}
      text={tr('services.intro.text')}
    />
    <blockquote class="relative pb-1 font-serif text-title leading-snug text-base-content/85">
      <span class="absolute -left-1 -top-9 font-serif text-6xl leading-none text-accent" aria-hidden="true">“</span>
      {tr('services.intro.approach')}
    </blockquote>
  </section>

  <!-- 02 Wedding collections -->
  <section id="weddings" class="shell scroll-mt-24 pt-section">
    <PageIntro
      as="h2"
      eyebrow={tr('services.weddings.eyebrow')}
      heading={tr('services.weddings.heading')}
      text={tr('services.weddings.text')}
    />
    <div class="mt-10 grid items-start gap-4 md:grid-cols-[5fr_7fr]" data-reveal-group>
      {
        weddingPackages.map((p) => (
          <article
            data-reveal="rise"
            class:list={['flex flex-col rounded-2xl bg-base-100 p-3', p.recommended && 'ring-2 ring-accent']}
          >
            {packagePhotos[p.id] && (
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-base-300" style={bg(packagePhotos[p.id])} data-reveal="image">
                <Image
                  src={packagePhotos[p.id]}
                  alt=""
                  widths={[400, 640, 900, 1200]}
                  sizes="(min-width: 768px) 44rem, 92vw"
                  class="fade-img size-full object-cover object-[50%_30%]"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-4 pt-6 md:p-6">
              <div class="flex min-h-7 items-center justify-between gap-4">
                <h3 class="eyebrow">{tr(`services.weddings.packages.${p.id}.name`)}</h3>
                {p.recommended && (
                  <span class="rounded-full bg-primary px-3 py-1 text-label font-medium text-primary-content">
                    {tr('services.weddings.recommended')}
                  </span>
                )}
              </div>
              <p class="mt-5 text-headline font-semibold">{price(p.price)}</p>
              <p class="mt-1 font-serif text-muted">{tr('units.upToHours', { n: p.upToHours })}</p>
              <p class="mt-6">{tr(`services.weddings.packages.${p.id}.summary`)}</p>
              <p class="eyebrow mt-8">{tr('services.weddings.includes')}</p>
              <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
                {tr(`services.weddings.packages.${p.id}.items`).map((item, i) => (
                  <li class="flex gap-3" style={`--d: ${i}`}>
                    <Doodle name="tick" class="mt-0.5 size-[1.15rem] shrink-0 text-accent" />
                    {item}
                  </li>
                ))}
              </ul>
              <p class="mt-8 text-sm text-muted">
                {tr('services.weddings.overtime')}: {price(p.overtimePerHour)} {tr('units.perHour')}
              </p>
              <div class="mt-auto pt-8">
                <a
                  href={bookHref('wedding')}
                  class:list={[
                    'inline-flex rounded-full px-5 py-2.5 text-[0.9375rem] font-medium transition-opacity hover:opacity-85',
                    p.recommended ? 'bg-primary text-primary-content' : 'bg-base-200 text-base-content',
                  ]}
                >
                  {tr('services.weddings.book')}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 03 More ways to remember -->
  <section class="shell pt-section">
    <PageIntro as="h2" eyebrow={tr('services.more.eyebrow')} heading={tr('services.more.heading')} />
    <div class="mt-10 grid gap-4 md:grid-cols-3" data-reveal-group data-dim-group>
      {
        moreServices.map((s) => {
          const m = momentOf(s.moment);
          return (
            <article id={s.id} class="flex scroll-mt-24 flex-col rounded-2xl bg-base-100 p-3" data-lift>
              {m && (
                <a href={`${momentsPath}${m.slug}/`} class="block aspect-[4/3] overflow-hidden rounded-xl bg-base-300" style={bg(m.cover)} data-reveal="image">
                  <Image
                    src={m.cover}
                    alt={m.entry.data.title}
                    widths={[320, 480, 640, 800]}
                    sizes="(min-width: 768px) 24rem, 92vw"
                    class="fade-img size-full object-cover object-top"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-4 pt-5">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-title font-semibold">{tr(`services.more.items.${s.id}.name`)}</h3>
                  <Doodle name={moreDoodles[s.id]} class="size-8 shrink-0 text-base-content/70" />
                </div>
                <p class="mt-2 font-serif text-muted">{moreMeta(s)}</p>
                <p class="mt-5 text-[0.9375rem]">{tr(`services.more.items.${s.id}.text`)}</p>
                <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-6 text-sm font-medium">
                  <a href={bookHref(s.id)} class="rounded-full bg-base-200 px-4 py-2 transition-opacity hover:opacity-85">
                    {tr('services.more.book')}
                  </a>
                  {m && (
                    <a href={`${momentsPath}${m.slug}/`} class="cta-link text-muted hover:text-base-content">
                      <span class="cta-text">{tr('services.more.seeMoment')}</span> <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- 04 How it works: a scroll story. A curving road is drawn as you scroll;
       each milestone lights up when the line reaches it and is ticked off once
       you move past it (src/scripts/services-road.js). -->
  <section class="shell pt-section">
    <PageIntro as="h2" eyebrow={tr('services.process.eyebrow')} heading={tr('services.process.heading')} />
    <div class="road relative mt-14" data-road>
      <svg class="road-svg" aria-hidden="true">
        <path class="road-base" />
        <path class="road-progress" />
        <circle class="road-tip" r="5" />
      </svg>
      <ol class="relative">
        {
          tr('services.process.steps').map((step, i) => (
            <li class="road-step" style={roadPlaces[i]} data-road-step>
              <div class="road-card rounded-2xl bg-base-100 p-5" data-road-node>
                <span class="road-num">{String(i + 1).padStart(2, '0')}</span>
                <div class="mt-2 flex items-center gap-3">
                  <Doodle name={stepDoodles[i]} class="size-8 shrink-0 text-base-content/75" />
                  <h3 class="text-lg font-semibold leading-tight md:text-xl">{step.title}</h3>
                </div>
                <p class="mt-2 text-[0.9375rem] text-muted">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="shell grid gap-10 pt-section md:grid-cols-[2fr_3fr] md:gap-12">
    <PageIntro as="h2" eyebrow={tr('services.faq.eyebrow')} heading={tr('services.faq.heading')} />
    <div class="divide-y divide-base-300 rounded-2xl bg-base-100 px-5 md:px-7">
      {
        tr('services.faq.items').map((item) => (
          <details class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium">
              {item.q}
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="pb-6 pr-8 text-[0.9375rem] text-muted">{fill(item.a)}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 06 Start a conversation -->
  <section id="inquiry" class="shell grid scroll-mt-24 gap-10 pt-section md:grid-cols-[2fr_3fr] md:gap-12">
    <PageIntro as="h2" eyebrow={tr('inquiry.eyebrow')} heading={tr('inquiry.heading')} text={tr('inquiry.text')} />
    <InquiryForm locale={locale} />
  </section>
</BaseLayout>

<style>
  /* ── How it works road ─────────────────────────────────────────────── */
  .road-svg {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke-linecap: round;
  }
  .road-base {
    stroke: var(--color-base-300);
    stroke-width: 2;
    stroke-dasharray: 2 9;
  }
  .road-progress {
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }
  .road-tip {
    fill: var(--color-accent);
    stroke: none;
  }
  /* Compact cards scattered across the width; the road runs between them
     (it passes under the cards, which sit above the drawing). */
  .road-step {
    --w: min(86%, 21rem);
    position: relative;
    width: var(--w);
    margin-top: calc(1.75rem + var(--gap, 0rem) * 0.5);
    margin-left: calc((100% - var(--w)) * var(--x, 0) * 0.6);
  }
  .road-step:first-child { margin-top: 0; }
  @media (min-width: 48rem) {
    .road-step {
      --w: 22rem;
      margin-top: calc(1rem + var(--gap, 0rem));
      margin-left: calc((100% - var(--w)) * var(--x, 0));
    }
  }
  .road-num {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--muted);
    transition: color 0.5s;
  }
  .road-card {
    position: relative;
    translate: 0 var(--py, 0px); /* gentle parallax, set by the script */
    transform-origin: center;
    transition:
      transform 0.8s var(--ease-soft),
      box-shadow 0.6s var(--ease-soft);
  }

  /* States (only once the script runs; otherwise everything is simply visible):
     the milestone in focus is larger and fully lit; the rest are smaller and quieter. */
  /* Only the contents dim; the card itself stays opaque so the road never shows through. */
  .road-card > * { transition: opacity 0.6s var(--ease-soft); }
  .road:global(.is-live) .road-card { transform: scale(0.92); }
  .road:global(.is-live) .road-card > * { opacity: 0.4; }
  .road:global(.is-live) .road-step:global(.is-passed) .road-card > * { opacity: 0.6; }
  .road:global(.is-live) .road-step:global(.is-current) .road-card > * { opacity: 1; }
  .road:global(.is-live) .road-step:global(.is-current) .road-card {
    transform: scale(1.06);
    box-shadow: 0 0 0 1.5px var(--color-accent);
  }
  .road:global(.is-live) .road-step:global(.is-current) .road-num { color: var(--color-accent); }

  /* FAQ: smooth open/close where supported (interpolate-size), a plus that turns into a cross. */
  .faq {
    interpolate-size: allow-keywords;
  }
  .faq::details-content {
    height: 0;
    overflow: clip;
    transition: height 0.5s var(--ease-soft), content-visibility 0.5s allow-discrete;
  }
  .faq[open]::details-content {
    height: auto;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon {
    position: relative;
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    transition: transform 0.45s var(--ease-spring);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    translate: 0 -50%;
  }
  .faq-icon::after { rotate: 90deg; }
  .faq[open] .faq-icon { transform: rotate(45deg); color: var(--color-accent); }

</style>

<script>
  import { initRoad } from '../../scripts/services-road.js';
  document.querySelectorAll('[data-road]').forEach(initRoad);
</script>

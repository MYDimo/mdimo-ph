---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MomentCard from '../../../components/MomentCard.astro';
import { locales, useT, localizedPath, formatDate, routes } from '../../../i18n/index.js';
import { getMoments, similarMoments } from '../../../data/moments.js';
import { bg, colorOf } from '../../../data/colors.js';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const moments = await getMoments(locale);
    for (const moment of moments) {
      const more = similarMoments(moment, moments);
      paths.push({ params: { locale, slug: moment.slug }, props: { moment, more } });
    }
  }
  return paths;
}

const { locale } = Astro.params;
const { moment, more } = Astro.props;
const tr = useT(locale);
const { entry, slug, images, cover } = moment;
const { title, date, categories, location } = entry.data;
const { Content } = await render(entry);
// Meta description: the story's first paragraph as plain text (markdown links unwrapped), ~160 chars.
const firstParagraph = entry.body.trim().split(/\n\s*\n/)[0].replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const description = firstParagraph.length > 160 ? `${firstParagraph.slice(0, 157).replace(/\s+\S*$/, '')}…` : firstParagraph;

const total = images.length;
// Search title and photo alt text carry the kind of event and the venue (what couples search for).
const seoVars = { kind: tr(`moments.seo.kind.${categories[0]}`), location, title };
const seoTitle = tr(location ? 'moments.seo.at' : 'moments.seo.plain', seoVars);
const altSubject = seoTitle.replaceAll(' · ', ', ');
const alt = (i) => (images[i] === cover && entry.data.coverAlt) || tr('moments.photoAlt', { title: altSubject, n: i + 1, total });
// Full-size versions for the lightbox (the imported files are already ≤2048px).
const full = await Promise.all(images.map((src) => getImage({ src, width: src.width, format: 'webp', quality: 82 })));
const coverIndex = images.indexOf(cover);

// Structured data: the Moment as an image gallery with its date, place and photos.
const abs = (p) => new URL(p, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: seoTitle,
  description,
  inLanguage: locale,
  url: abs(Astro.url.pathname),
  datePublished: date.toISOString().slice(0, 10),
  ...(location && { contentLocation: { '@type': 'Place', name: location } }),
  author: { '@type': 'Person', name: tr('site.name') },
  image: full.map((f, i) => ({ '@type': 'ImageObject', contentUrl: abs(f.src), width: f.attributes.width, height: f.attributes.height, caption: alt(i) })),
};
// Each Moment carries a faint wash of its own cover colour (header + lightbox).
const tint = colorOf(cover) ?? 'transparent';
---

<BaseLayout locale={locale} title={seoTitle} description={description} image={cover} imageAlt={alt(coverIndex)} imagePosition={entry.data.previewCrop} jsonLd={jsonLd}>
  <!-- Reading progress: an accent hairline across the top that fills as you scroll. -->
  <div class="read-progress" aria-hidden="true" data-read-progress></div>
  <article
    class="relative isolate"
    style={`--moment-tint: ${tint}`}
    data-gallery
    data-lb-close={tr('moments.lightbox.close')}
    data-lb-zoom={tr('moments.lightbox.zoom')}
    data-lb-prev={tr('moments.lightbox.prev')}
    data-lb-next={tr('moments.lightbox.next')}
    data-lb-error={tr('moments.lightbox.error')}
  >
    <!-- The event's colour, washing softly down from the top of the page. -->
    <div class="moment-tint" aria-hidden="true"></div>
    <header class="shell grid items-end gap-8 pt-10 md:grid-cols-2 md:gap-12 md:pt-16">
      <div class="md:pb-4">
        <a href={localizedPath(locale, routes.moments)} class="cta-link text-sm text-muted hover:text-base-content">
          <span class="arrow arrow-back" aria-hidden="true">←</span> <span class="cta-text">{tr('moments.back')}</span>
        </a>
        <p class="mt-8 font-serif text-lg text-muted">
          {categories.map((c) => tr(`moments.filters.${c}`)).join(' · ')} · {formatDate(locale, date, { month: 'long', year: 'numeric' })}
          {location && ` · ${location}`}
        </p>
        <h1 class="mt-3 text-display" style={`view-transition-name: moment-title-${slug}`}>{title}</h1>
        <div class="prose-moment mt-6 max-w-lg text-muted"><Content /></div>
        <p class="mt-6 text-sm text-muted">{tr('moments.photos', { n: total })}</p>
      </div>
      <a
        href={full[coverIndex].src}
        data-pswp
        data-pswp-width={full[coverIndex].attributes.width}
        data-pswp-height={full[coverIndex].attributes.height}
        data-cropped="true"
        class="block aspect-[4/5] overflow-hidden rounded-2xl bg-base-300"
        style={bg(cover, `view-transition-name: moment-cover-${slug}`)}
      >
        <Picture formats={['avif']} fallbackFormat="webp"
          src={cover}
          alt={alt(coverIndex)}
          widths={[480, 640, 800, 1000, 1200]}
          sizes="(min-width: 768px) 36rem, 92vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-top"
        />
      </a>
    </header>

    <!-- Masonry: CSS columns keep every photo uncropped at its natural shape. -->
    <div class="shell pt-section">
      <div class="columns-2 gap-3 md:columns-3 md:gap-4">
        {
          images.map((src, i) =>
            i === coverIndex ? null : (
              <a
                href={full[i].src}
                data-pswp
                data-pswp-width={full[i].attributes.width}
                data-pswp-height={full[i].attributes.height}
                class="mb-3 block break-inside-avoid overflow-hidden rounded-lg bg-base-300 md:mb-4"
                style={bg(src, '--reveal-radius: 1.25rem')}
                data-reveal="image"
              >
                <Picture formats={['avif']} fallbackFormat="webp"
                  src={src}
                  alt={alt(i)}
                  widths={[320, 480, 640, 800, 1000]}
                  sizes="(min-width: 768px) min(31vw, 24rem), 46vw"
                  class="fade-img w-full"
                />
              </a>
            ),
          )
        }
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="shell pt-section">
        <h2 class="text-headline">{tr('moments.more')}</h2>
        {/* Native scroll-snap row: swipe on touch, scroll with trackpad; no library. */}
        <div class="more-row mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2">
          {more.map((m) => (
            <div class="w-[72%] shrink-0 snap-start sm:w-[40%] lg:w-[calc((100%-3rem)/4)]">
              <MomentCard locale={locale} moment={m} sizes="(min-width: 1024px) 18rem, 72vw" />
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .prose-moment :global(p + p) { margin-top: 1em; }
  .prose-moment :global(a) { color: var(--color-base-content); text-decoration: underline; text-underline-offset: 3px; }
  .more-row { scrollbar-width: none; }
  .moment-tint {
    position: absolute;
    inset: -5rem 0 auto; /* reach up under the transparent header */
    height: 85vh;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--moment-tint) 26%, transparent),
      color-mix(in oklab, var(--moment-tint) 8%, transparent) 55%,
      transparent
    );
  }
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .more-row::-webkit-scrollbar { display: none; }

  /* Lightbox: same tonal world as the page instead of a black void. */
  :global(:root .pswp) {
    /* The lightbox takes on a whisper of the event's colour too. */
    --pswp-bg: color-mix(in oklab, var(--lightbox-tint, transparent) 10%, var(--color-base-200));
    --pswp-icon-color: var(--color-base-content);
    --pswp-icon-color-secondary: var(--color-base-200);
    --pswp-icon-stroke-color: var(--color-base-200);
    --pswp-placeholder-bg: var(--color-base-300);
  }
  /* Fallback corner radius; src/scripts/lightbox.js keeps the visible radius constant through the zoom. */
  :global(.pswp__img) { border-radius: 1.25rem; }
  :global(.pswp__counter) { color: var(--muted); text-shadow: none; }
</style>

<script>
  import { initLightbox } from '../../../scripts/lightbox.js';
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    // The lightbox is appended to <body>, outside the article, so hand it the tint.
    document.documentElement.style.setProperty('--lightbox-tint', gallery.style.getPropertyValue('--moment-tint'));
    initLightbox(gallery);
  });

  // Reading progress bar: scale the hairline with how far through the page we are.
  const bar = document.querySelector('[data-read-progress]');
  let queued = false;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    queued = false;
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>

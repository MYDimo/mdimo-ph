---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import MomentCard from '../../../components/MomentCard.astro';
import { useT } from '../../../i18n/index.js';
import { getMoments } from '../../../data/moments.js';
import { categories } from '../../../content.config.js';
export { localeStaticPaths as getStaticPaths } from '../../../i18n/paths.js';

const { locale } = Astro.params;
const tr = useT(locale);
const moments = await getMoments(locale);
// Only offer filters for categories that actually have Moments.
const used = categories.filter((c) => moments.some((m) => m.entry.data.categories.includes(c)));
---

<BaseLayout locale={locale} title={tr('moments.title')} description={tr('seo.moments')} image={moments[0]?.cover}>
  <section class="shell pt-16 md:pt-24">
    <PageIntro heading={tr('moments.heading')} text={tr('moments.text')} />

    <!-- Filter chips: invisible (but taking their space, so nothing shifts) until the script
         runs; without JS every Moment simply shows. -->
    <div class="invisible relative mt-10 flex flex-wrap gap-2" role="group" aria-label={tr('moments.filterLabel')} data-filters>
      <!-- One shared pill that glides behind the active chip. -->
      <span class="filter-indicator" aria-hidden="true" data-filter-indicator></span>
      {
        ['all', ...used].map((c) => (
          <button
            type="button"
            class="filter-chip rounded-full px-4 py-2 text-sm font-medium transition-colors"
            data-filter={c}
            aria-pressed={c === 'all' ? 'true' : 'false'}
          >
            {tr(`moments.filters.${c}`)}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-moments data-dim-group>
      {moments.map((m, i) => <MomentCard locale={locale} moment={m} eager={i === 0} priority={i === 0} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .filter-chip {
    position: relative;
    z-index: 1;
    background: var(--color-base-100);
    color: var(--muted);
    transition: color 0.35s var(--ease-soft), background-color 0.35s;
  }
  .filter-chip:hover { color: var(--color-base-content); }
  .filter-chip[aria-pressed='true'] { background: transparent; color: var(--color-primary-content); }
  /* Before the script positions the indicator, the active chip paints itself. */
  [data-filters]:not(.has-indicator) .filter-chip[aria-pressed='true'] { background: var(--color-primary); }
  .filter-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 999px;
    background: var(--color-primary);
    transition:
      transform 0.55s var(--ease-spring),
      width 0.55s var(--ease-spring),
      height 0.55s var(--ease-spring);
  }
  /* A tiny accent dot inside the active chip. */
  .filter-chip[aria-pressed='true']::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 0.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    vertical-align: middle;
  }
</style>

<script>
  const bar = document.querySelector('[data-filters]');
  const indicator = bar.querySelector('[data-filter-indicator]');
  const cards = document.querySelectorAll('[data-moments] > [data-categories]');
  const chips = bar.querySelectorAll('[data-filter]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* Move the shared pill under the active chip (it springs there via CSS). */
  function placeIndicator(chip, instant = false) {
    if (instant) indicator.style.transition = 'none';
    indicator.style.width = `${chip.offsetWidth}px`;
    indicator.style.height = `${chip.offsetHeight}px`;
    indicator.style.transform = `translate(${chip.offsetLeft}px, ${chip.offsetTop}px)`;
    if (instant) requestAnimationFrame(() => (indicator.style.transition = ''));
  }

  function apply(filter) {
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter)));
    cards.forEach((card) => {
      card.hidden = filter !== 'all' && !card.dataset.categories.split(' ').includes(filter);
    });
    // Keep the choice in the URL (e.g. #weddings) so it survives back/forward and can be shared.
    history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
  }

  function choose(chip) {
    // Mark the chip active first: its accent dot changes its width, which the pill matches.
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    placeIndicator(chip);
    const update = () => apply(chip.dataset.filter);
    // Cards glide to their new places: each cover/title already has a view-transition
    // name, so a same-document transition morphs them; hidden cards fade out.
    if (document.startViewTransition && !reduce.matches) document.startViewTransition(update);
    else update();
  }

  chips.forEach((chip) => chip.addEventListener('click', () => choose(chip)));
  const initial = location.hash.slice(1);
  const start = [...chips].find((c) => c.dataset.filter === initial) ?? chips[0];
  apply(start.dataset.filter);
  bar.classList.remove('invisible');
  bar.classList.add('has-indicator');
  placeIndicator(start, true);
  window.addEventListener('resize', () => placeIndicator(bar.querySelector('[aria-pressed="true"]'), true));
</script>

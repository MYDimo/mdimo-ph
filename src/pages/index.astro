---
// Fallback for "/" only (Netlify redirects it server-side via public/_redirects).
// No visible text: just the site's background colour while it hops to /en/ or /bg/.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Mihaylo Dimo</title>
    <link rel="canonical" href={new URL('/en/', Astro.site).href} />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <style>
      html { background: #f5f5f7; }
      @media (prefers-color-scheme: dark) { html { background: #111113; } }
    </style>
    <script is:inline>
      var lang = (navigator.languages || [navigator.language || '']).some(function (l) { return /^bg\b/i.test(l); });
      location.replace(lang ? '/bg/' : '/en/');
    </script>
  </head>
  <body></body>
</html>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, useT, switchLocalePath } from '../i18n/index.js';

const { locale, title, description } = Astro.props;
const tr = useT(locale);
const siteName = tr('site.name');
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const pageDescription = description ?? tr('site.description');
const path = Astro.url.pathname;
const alternate = (l) => new URL(switchLocalePath(path, l), Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={new URL(path, Astro.site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={alternate(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alternate('en')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!--
      Apply the theme before first paint (no flash): a saved manual choice wins,
      otherwise follow the system setting, with light as the fallback.
    -->
    <script is:inline>
      (function () {
        var saved;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var theme = saved === 'light' || saved === 'night'
          ? saved
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content"
      >{tr('nav.skip')}</a
    >
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

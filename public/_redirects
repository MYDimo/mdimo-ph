# Netlify: send the bare domain straight to the visitor's language (Bulgarian
# browsers → /bg/, everyone else → /en/). The "!" forces the redirect even though
# a fallback index.html exists at "/", so no intermediate page is ever shown.
/  /bg/  302!  Language=bg
/  /en/  302!

# Missing pages under /bg/ get the Bulgarian 404 (everything else uses /404.html).
/bg/*  /bg/404/  404
